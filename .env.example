# Slack webhook for LinkedIn bot notifications
SLACK_WEBHOOK_URL=

# SMTP settings if you prefer email notifications instead of, or in addition to, Slack
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Slack bot setup
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_BOT_STATE_FILE=.slack-chat-bot/state.json

# Shared OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SYSTEM_PROMPT=

# Earth launch tracker
DATABASE_URL=
LAUNCH_SYNC_SECRET=
LAUNCH_TRACKER_APP_PORT=3001
LAUNCH_TRACKER_DATA_FILE=.launch-tracker-data.json
LAUNCH_LIBRARY_API_BASE=https://ll.thespacedevs.com/2.0.0
LAUNCH_LIBRARY_PAGE_SIZE=100
LAUNCH_SYNC_MAX_REQUESTS_PER_HOUR=15
LAUNCH_UPCOMING_STALE_MS=900000
LAUNCH_SYNC_LOCK_TTL_MS=600000

# Social scene finder
SOCIAL_SCENE_APP_PORT=3001
SOCIAL_SCENE_OPENAI_MODEL=gpt-5.4-mini

# Social media API
SOCIAL_MEDIA_API_PORT=3010
SOCIAL_MEDIA_API_DATA_FILE=data/social-media-api.json
SOCIAL_MEDIA_API_SEED_DEMO=true

# Earnings call analyzer
ALPHA_VANTAGE_API_KEY=
SEC_USER_AGENT=earnings-call-analyzer/1.0 your-email@example.com
EARNINGS_OPENAI_MODEL=gpt-5-mini

# Marine biology RAG app
# Use OPENAI_API_KEY above or this app-specific key.
MARINE_RAG_OPENAI_API_KEY=
MARINE_RAG_ANTHROPIC_API_KEY=
MARINE_RAG_LLM_PROVIDER=openai
MARINE_RAG_OPENAI_MODEL=gpt-4o-mini
MARINE_RAG_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
MARINE_RAG_EMBEDDING_PROVIDER=openai
MARINE_RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MARINE_RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MARINE_RAG_ENABLE_RERANKING=true
MARINE_RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MARINE_RAG_RAW_DOCS_DIR=data/raw_docs
MARINE_RAG_STORAGE_DIR=data/storage
MARINE_RAG_CHROMA_COLLECTION=marine_biology_docs
MARINE_RAG_CHROMA_HOST=
MARINE_RAG_CHROMA_PORT=8000
MARINE_RAG_CHROMA_SSL=false
MARINE_RAG_REDIS_URL=
MARINE_RAG_CACHE_TTL_SECONDS=900
MARINE_RAG_CHUNK_SIZE=900
MARINE_RAG_CHUNK_OVERLAP=150
MARINE_RAG_SIMILARITY_TOP_K=20
MARINE_RAG_FINAL_TOP_K=5

# Optional: model used by evals/run_deepeval.py as the DeepEval judge.
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini
